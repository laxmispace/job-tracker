# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── AI keys (server-side only, never sent to the browser) ─────────
# Add as many as you like. Switch between them from the ✨ dropdown in the
# app header or the extension popup. Leave the ones you don't use empty.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Optional: default model per provider (you can also pick in AI settings)
# GEMINI_MODEL=gemini-3.8-flash
# DEEPSEEK_MODEL=deepseek-flash
# QWEN_MODEL=qwen-plus
# OPENROUTER_MODEL=
# GROQ_MODEL=

# Optional: Qwen mainland-China endpoint instead of international
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: Ollama on your Mac (works only with `npm run dev` locally)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# Optional: any other OpenAI-compatible API (Kimi, GLM, …)
# CUSTOM_NAME=Kimi
# CUSTOM_BASE_URL=
# CUSTOM_API_KEY=
# CUSTOM_MODEL=

# Only these sign-in emails may use the keys above; everyone else connects
# their own in AI settings. Leave empty to share your keys with all users.
OWNER_EMAILS=

# Optional: encryption secret for users' own keys (defaults to the Supabase JWT secret)
# KEY_ENCRYPTION_SECRET=

# Optional: which provider new sessions start on
# AI_PROVIDER=gemini
